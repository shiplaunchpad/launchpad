{
  "description": "launchpad: when a session opens in an app launchpad knows, make sure Mission Control is running and show its next step and address; tell an open Claude session what changed in Mission Control since its last step (one line; silent otherwise); and, on a free build, what is and is not on this computer.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/dist/launchpad.mjs\" ] && node \"${CLAUDE_PLUGIN_ROOT}/dist/launchpad.mjs\" free-note --hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/dist/launchpad.mjs\" ] && node \"${CLAUDE_PLUGIN_ROOT}/dist/launchpad.mjs\" session-sync --hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/dist/launchpad.mjs\" ] && node \"${CLAUDE_PLUGIN_ROOT}/dist/launchpad.mjs\" session-sync --hook || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
